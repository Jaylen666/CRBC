# Copy to .env in the project root, or set ENV_FILE to another file.
# Existing process environment variables take precedence over this file.
# Use plain KEY=value lines; shell expansion is not performed.

# Required for spec extraction and candidate/reference analysis.
# BASE_URL is the API root (usually ending in /v1), not a model web UI URL.
CRBC_OPENAI_API_KEY=replace-with-your-api-key
CRBC_OPENAI_BASE_URL=https://api.example.com/v1
CRBC_OPENAI_MODEL=replace-with-your-chat-model

# Optional separate provider for source-level review. It must support the Responses API.
# To use these values, pass --phase3-provider CRBC_REVIEW to run_crbc.py,
# or --provider-env-prefix CRBC_REVIEW to run_phase3.py.
# If the main provider supports both APIs, omit this block and use CRBC_OPENAI.
# CRBC_REVIEW_API_KEY=replace-with-your-review-api-key
# CRBC_REVIEW_BASE_URL=https://api.example.com/v1
# CRBC_REVIEW_MODEL=replace-with-your-tool-capable-review-model

# Optional explicit override for the source-level review model.
# CRBC_PHASE3_MODEL=replace-with-your-review-model
